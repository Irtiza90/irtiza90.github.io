---
import Layout from "../layouts/Layout.astro";

import { SITE } from "../data/site";
import { ABOUT } from "../data/about";

const title = "Contact Me | Irtiza Babar";
const description = SITE.description;
const formSpreeURL = SITE.formSpreeURL;
---

<Layout {title} {description}>
  <section id="contact-form">
    <h1 class="title">Send a Message</h1>

    <form action={formSpreeURL} method="POST">
      <div class="form-group">
        <label>
          Your email:
          <input required type="email" name="email" class="font-lora" />
        </label>
      </div>

      <div class="form-group" style="margin-top: 2rem;">
        <label>
          Your message:
          <textarea required name="message" class="font-lora"></textarea>
        </label>
      </div>

      <button type="submit" class="btn project-btn btn-color-1 bd-0">Send</button>
    </form>
  </section>
</Layout>

<style>
  #contact-form {
    max-width: 75%;
    margin: 5rem auto;
  }

  #contct-form label {
    font-size: 1.5rem;
  }

  #contact-form input[name="email"] {
    border-radius: 2rem;
    border:  0.1rem solid rgb(250, 250, 250);
    border-color: rgb(163, 163, 163);
    margin: 1rem auto;
    padding: 1rem 1rem;
    width: 100%;
    font-size: 1rem;
  }

  #contact-form textarea[name="message"] {
    border-radius: 2rem;
    border: 0.1rem solid rgb(163, 163, 163);
    background: rgb(250, 250, 250);
    margin: 1rem auto;
    padding: 1rem;
    width: 561px;
    min-height: 10rem;
    height: 87px;
    max-width: 100%;
    min-width: 100%;
    font-size: 1rem;
  }
</style>
