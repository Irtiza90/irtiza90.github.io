---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';

import { PROJECTS } from '../data/projects';
import { SKILLS } from '../data/skills';
import { SITE } from '../data/site';
import { ABOUT } from '../data/about';

import codingImg from '../assets/images/coding.webp';
import codingGif from '../assets/images/coding.gif';
import dotsBgImg from '../assets/images/dots-bg.jpg';
import aboutImg from  '../assets/images/about-pic.jpg';

const title = SITE.title;
const description = SITE.description;
---

<Layout {title} {description}>
  <section id="profile">
    <div class="section__pic-container">
      <!-- static placeholder (replaced with gif) -->
      <Image 
        src={codingImg}
        alt="code typing gif"
        class="gif-replace"
        width={500}
        height={300}
        loading="eager"
        fetchpriority="high"
        data-gif={codingGif.src}
      />
      
      <!-- <Image src={codingImg} alt="Person Coding gif" loading={"eager"} fetchpriority={"high"} /> -->
    </div>
    <div class="section__text">
      <div id="intro">
        <h1 class="intro__heading">
          <span class="intro__start">Hello, I'm</span>
          <span class="intro__name">Irtiza</span>
        </h1>
        <h2 class="intro__subheading">FullStack Developer</h2>
      </div>
      <div class="btn-container justify-content-center mb-4">
        <a href={SITE.cv} target="_blank" class="no-style" aria-label="Download CV">
          <button class="btn btn-color-2" type="button">Download CV</button>
        </a>
        <a class="no-style" href="#contact" aria-label="Contact Me">
          <button class="btn btn-color-1" type="button">Contact Info</button>
        </a>
      </div>
      <div id="socials-container">
        <a class="no-style" target="_blank" href={ABOUT.linkedin} aria-label="LinkedIn Profile">
          <img src="/assets/icons/linkedin.svg" alt="LinkedIn profile" class="icon" />
        </a>
        <a class="no-style" target="_blank" href={ABOUT.github} aria-label="Github Profile">
          <img src="/assets/icons/github.svg" alt="Github profile" class="icon" />
        </a>
      </div>
    </div>
  </section>

  <section id="about">
    <p class="section__text__p1">Get To Know More</p>
    <h2 class="title">About Me</h2>
    <div class="section-container">
      <div class="section__pic-container">
        <Image src={aboutImg} alt="About Me" class="about-pic" loading="lazy" decoding="async" />
      </div>
      <div class="about-details-container">
        <div class="about-containers d-flex">
          <div class="details-container">
            <img src="/assets/icons/medal.svg" alt="Experience icon" class="icon" loading="lazy" decoding="async" />
            <h3>Experience</h3>
            <p>2+ years <br />FullStack Development</p>
          </div>
          <div class="details-container">
            <img src="/assets/icons/education-cap.svg" alt="Education icon" class="icon" loading="lazy" decoding="async" />
            <h3>Education</h3>
            <p>Diploma in Software Engineering <small>(PRESENT)</small></p>
          </div>
        </div>
        <div class="text-container">
          <p>
            I'm a Full-Stack developer based in Pakistan with a passion for web development & designing. I have a solid foundation in multiple languages and enjoy working on the backend with Laravel. When it comes to web design and frontend development, I enjoy creating modern, and user-friendly sites. I focus on creating sites that not only looks good, but also performs efficiently and meets the user's needs.
          </p>
        </div>
        <button onclick="window.location.href = '/about'" class="more-about-btn mt-4 btn btn-color-2">More</button>
      </div>
    </div>

    <a href="#experience" class="no-style" aria-label="Scroll to Skills">
      <img src="/assets/icons/down-arrow.svg" alt="Arrow icon" class="Scroll to Skills" loading="lazy" style="height: 3rem;" />
    </a>
  </section>

  <section id="experience" style="position: relative;">
    <Image class="exp-bg-image" src={dotsBgImg} loading={"lazy"} decoding={"async"} aria-hidden="true" alt="dots background" />

    <div class="container">
      <p class="section__text__p1">Explore My</p>
      <h2 class="title">Skills</h2>
      <div id="skills-container" class="experience-details-container">
        <div class="about-containers">
          <div class="container">
            <h2 class="experience-sub-title mt-4">Frontend</h2>
            <div class="skills-container d-flex flex-wrap">
              {SKILLS.frontend.map(skill => (
                <div class="skill py-4">
                  <div>
                    <p><img class="icon" src={skill.icon} alt={skill.name} decoding="async" loading="lazy" /></p>
                    <h3>{skill.name}</h3>
                  </div>
                </div>
              ))}
            </div>

            <h2 class="experience-sub-title mt-4">Backend</h2>
            <div class="skills-container d-flex flex-wrap">
              {SKILLS.backend.map(skill => (
                <div class="skill py-4">
                  <div>
                    <p><img class="icon" src={skill.icon} alt={skill.name} decoding="async" loading="lazy" /></p>
                    <h3>{skill.name}</h3>
                  </div>
                </div>
              ))}
            </div>

            <h2 class="experience-sub-title mt-4">Extras</h2>
            <div class="skills-container d-flex flex-wrap">
              {SKILLS.extras.map(skill => (
                <div class="skill py-4">
                  <div>
                    <p><img class="icon" src={skill.icon} alt={skill.name} decoding="async" loading="lazy" /></p>
                    <h3>{skill.name}</h3>
                  </div>
                </div>
              ))}
            </div>
          </div>
        </div>

        <a href="#projects" class="no-style" aria-label="Scroll to Projects">
          <img src="/assets/icons/down-arrow.svg" alt="Scroll to Projects" class="icon arrow" loading="lazy" decoding="async" />
        </a>
      </div>
    </div>
  </section>

  <section id="projects" class="smooth-wrapper no-mg">
    <progress id="projects-bg-progress" class="hidden" value="0" max="40"></progress>

    <div id="projects-container" class="container experience-details-container smooth-content">
      <p class="section__text__p1">Browse My Recent</p>
      <h2 class="title">Projects</h2>

      <div class="about-containers">
        {PROJECTS.map(project => (
          <div class="project-wrapper">
            <div class="project details-container color-container">
              <div class="article-container row">
                <div class="project-img-container col-12 col-md-6 col-lg-4">
                  <img src={project.image} alt={project.title} class="project-img img-fluid" decoding="async" loading="lazy" />
                </div>
                <div class="col-sm-12 col-md-6 col-lg-8">
                  <h3 class="experience-sub-title project-title">{project.title}</h3>

                  <div class="d-none d-lg-block">
                    <div class="content" set:html={project.description}></div>

                    <div class="btn-container mt-4">
                      {project.liveUrl && (
                        <a
                          class="btn btn-color-2 project-btn"
                          href={project.liveUrl}
                          target="_blank"
                          rel="noopener"
                        >
                          {project.viewBtnText}
                        </a>
                      )}
                    </div>
                  </div>
                </div>
                <div class="col-12 d-lg-none mt-2 mt-lg-0">
                  <div class="content" set:html={project.description}></div>

                  <div class="btn-container mt-4">
                    {project.liveUrl && (
                      <a
                        class="btn btn-color-2 project-btn"
                        href={project.liveUrl}
                        target="_blank"
                        rel="noopener"
                      >
                        {project.viewBtnText}
                      </a>
                    )}
                  </div>
                </div>
              </div>
            </div>
          </div>
        ))}
      </div>

      <a href="https://github.com/Irtiza90?tab=repositories"
        class="btn btn-color-1 mx-auto view-more-proj-btn"
        aria-label="View More Projects" target="_blank" rel="noopener"
      >
        View More
      </a>
    </div>
  </section>

  <section id="contact">
    <p class="section__text__p1">Get in Touch</p>
    <h2 class="title">Contact Me</h2>
    <div class="contact-info-upper-container">
      <div class="contact-info-container">
        <img src="/assets/icons/email.svg" alt="Email icon" class="icon contact-icon email-icon" height="40" width="40" loading="lazy" />
        <p><a href={"mailto:" + ABOUT.email} aria-label="Email Me">{ABOUT.email}</a></p>
      </div>
      <div class="contact-info-container">
        <img src="/assets/icons/linkedin-txt.svg" alt="LinkedIn icon" class="icon contact-icon object-fit-cover" height="40" width="40" loading="lazy" />
        <p><a target="_blank" href={ABOUT.linkedin} aria-label="LinkedIn Profile">LinkedIn</a></p>
      </div>
    </div>
  </section>
</Layout>

<style>
  #experience .exp-bg-image {
    position: absolute;
    width: 100%;
    height: 114%;
    top: 0;
    left: 0;
    border-radius: 2rem;
    filter: saturate(0.1);
    z-index: -1;
    opacity: 0.6;
    font-size: 0;
    color: transparent;
  }

  #projects .view-more-proj-btn {
    margin-bottom: 8rem;
    position: absolute;
    bottom: 0;
    left: 50%;
    transform: translateX(-50%);
  }

  .gif-replace {
    transition: opacity 1s ease-in-out;
  }
</style>
<script is:inline>
  document.addEventListener("DOMContentLoaded", () => {
    const img = document.querySelector(".gif-replace");
    const gifSrc = img.dataset.gif;

    const gif = new Image();
    gif.src = gifSrc;
    gif.onload = () => {
      img.src = gifSrc;
    };
  });
</script>
<script src="../scripts/index.js"></script>
