---
import { NAV_LINKS } from '../data/site';
---

<div id="menu">
  <div class="menu-toggle">
    <div class="bar1"></div>
    <div class="bar2"></div>
    <div class="bar3"></div>
  </div>

  <div class="fullscreen-menu">
    <ul>
      {NAV_LINKS.map((link) => (
        <li><a class="nav-link" href={link.path}>{link.name}</a></li>
      ))}
    </ul>
  </div>
</div>

<nav id="desktop-nav" style="margin-left: 20%;">
  <div class="logo">
    <a class="no-style" href="/" aria-label="Home">Irtiza Babar</a>
  </div>
</nav>

<nav id="hamburger-nav">
  <div class="logo">Irtiza Babar</div>
  <div class="hamburger-menu"></div>
</nav>
