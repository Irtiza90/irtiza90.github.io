---

interface BreadcrumbItem {
  name: string;
  link: string;
}

const { items } = Astro.props as { items: BreadcrumbItem[] };

const schema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: items.map((item, index) => ({
    "@type": "ListItem",
    position: index + 1,
    name: item.name,
    item: item.link
  }))
};
---

<script type="application/ld+json" set:html={
  JSON.stringify(schema, null, 2)
}>
</script>